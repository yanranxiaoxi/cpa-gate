# ===== 服务器 =====
ENV_PRODUCT=development
SERVER_HOST=0.0.0.0
SERVER_PORT=3001
SERVER_NAME=cpa-gate
PROJECT_NAME=cpa-gate
LOG_LEVEL=info

# ===== CLIProxyAPI =====
# 管理 API 基址（origin + 可选 base path，不含 /v0/management）
CPA_MANAGEMENT_URL=http://127.0.0.1:8317
# CLIProxyAPI Management Key（只存在于服务端）
CPA_MANAGEMENT_KEY=
# 用户实际调用的公网基址；留空则与管理地址一致。页面展示 ${CPA_API_BASE_URL}/v1
CPA_API_BASE_URL=
# 上游请求超时（毫秒）
CPA_TIMEOUT_MS=10000
# 模型列表缓存秒数（0 = 不缓存）
MODELS_CACHE_TTL=60

# ===== OIDC 登录（四项齐全才启用登录）=====
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# 如 https://cpa-gate.example.com/api/auth/callback
OIDC_REDIRECT_URI=
OIDC_SCOPE=openid profile email
# 仅本地开发/测试：允许 http:// 的 issuer（生产环境必须留空）
OIDC_ALLOW_INSECURE=false
# 页面显示的用户名
OIDC_USERNAME_CLAIM=preferred_username
# 写入 Key 前缀的用户 ID；必须能用于 Keycloak Admin API 查询（Keycloak 需为 public subject type）
OIDC_USER_ID_CLAIM=sub
# SSO 提供商名称，显示在登录弹窗按钮上；留空使用本地化默认文案
OIDC_PROVIDER_NAME=
# SSO 用户中心地址；配置后登录时右上角用户名变为可点击链接。只接受 http/https
OIDC_ACCOUNT_URL=
# 登出 SSO 时的 IdP 回跳地址；留空则自动取 OIDC_REDIRECT_URI 的站点根
OIDC_POST_LOGOUT_REDIRECT_URI=

# ===== Keycloak Admin API（校验用户状态与用户组）=====
# 允许的用户组：逗号分隔或 JSON 数组；支持组名（ai）或完整路径（/staff/ai）
# 与 ALLOWED_USERS 同时配置时取并集；两者至少要配置一个
ALLOWED_GROUPS=/staff/ai
# 允许的具体用户：逗号分隔或 JSON 数组
# 裸值同时匹配 UUID、用户名、邮箱；也可用 uuid: / username: / email: 前缀限定
# 登录被拒页面会显示该用户自己的 UUID，直接复制即可
ALLOWED_USERS=
# 默认从 OIDC_ISSUER 推导（https://sso.example.com/realms/main → https://sso.example.com + main）
KEYCLOAK_ADMIN_BASE_URL=
KEYCLOAK_REALM=
# 专供 Admin API 的机密客户端（Client authentication + Service accounts roles）
# 创建后到 Credentials 页复制 Secret；Service accounts roles 里分配
# realm-management 的 view-users 与 query-groups
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_ADMIN_TIMEOUT_MS=10000

# ===== 会话 =====
# 必填，至少 32 字节随机值（启动时强制校验，不足直接退出）：openssl rand -base64 48
SESSION_SECRET=
SESSION_COOKIE_NAME=cpa_session
# 会话有效期（秒），默认 7 天
SESSION_TTL=604800

# ===== 自动清理 =====
# 定期扫描受管 Key，删除已离开允许组、已禁用或已删除用户的 Key（撤销的唯一机制）
# 单位秒，默认 1800（30 分钟）。设为 0 关闭：被移除的用户会一直保留可用 Key
PRUNE_INTERVAL=1800

# ===== 站点品牌（可选，按语言分别配置）=====
# 留空的项使用该语言的默认文案（中文：CPA Gate / CLIProxyAPI / 使用 SSO 登录，获取你的 CLIProxyAPI 密钥；
# 英文：CPA Gate / CLIProxyAPI / Sign in with SSO to get your CLIProxyAPI key）
# title 同时用于浏览器标题、顶栏品牌与页面主标题；subtitle 显示在顶栏品牌右侧；
# description 同时用于页面副标题与 meta description
SITE_TITLE_ZH_HANS=
SITE_SUBTITLE_ZH_HANS=
SITE_DESCRIPTION_ZH_HANS=
SITE_TITLE_EN=
SITE_SUBTITLE_EN=
SITE_DESCRIPTION_EN=

# ===== 静态资源 =====
# 留空自动解析（生产 dist/public，开发 public）
STATIC_DIR=
